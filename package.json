{
  "name": "godfield-lite",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:sandbox": "vite --mode sandbox",
    "build": "vite build",
    "build:sandbox": "vite build --mode sandbox",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "db:push": "npx supabase link --project-ref jwhdynpvsojlpkwfxhou && npx supabase db push",
    "fn:deploy": "npx supabase functions deploy game --project-ref jwhdynpvsojlpkwfxhou --use-api",
    "catalog:sql": "node scripts/catalog-sql.js",
    "cards:art": "node scripts/card-art.js",
    "backgrounds": "node scripts/backgrounds.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  }
}
